# Copy this file to .env.docker and replace every placeholder before use.
# .env.docker is ignored by Git.
MYSQL_ROOT_PASSWORD=replace-with-a-random-local-root-password
MYSQL_DEV_PASSWORD=replace-with-a-random-local-dev-password
PII_ENCRYPTION_KEY=replace-with-a-random-local-encryption-key
ACADEMY_PLAYBACK_TOKEN_SECRET=replace-with-a-random-local-playback-secret
DEMO_FRONTEND_PORT=8080
