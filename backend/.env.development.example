# Development backend example. Copy to .env.development.
NODE_ENV=development
APP_ENV=development
TEST_SAFE_MODE=true
PORT=4001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MOBILE_APP_ORIGINS=https://localhost,capacitor://localhost
SITE_URL=http://localhost:5173
UPLOAD_ROOT=uploads-dev

DB_INIT_MODE=safe
ALLOW_DESTRUCTIVE_MIGRATIONS=false
ALLOW_STARTUP_DATA_PURGE=false
ALLOW_STARTUP_SCHEMA_DROP=false
ALLOW_STARTUP_USER_PURGE=false
ALLOW_STARTUP_SCHEMA_BOOTSTRAP=false
ALLOW_STARTUP_SCHEMA_ALTER=false
ALLOW_STARTUP_DATA_REPAIR=false
ALLOW_E2E_DATA_MUTATION=false

# Local backend development uses an SSM port forwarding session to the shared development RDS.
# Start `npm run tunnel:dev:db` before the backend. The EC2 development backend
# connects to the same RDS directly on port 3306 using its server-only env file.
# Use only the dedicated development DB and least-privilege account.
DB_HOST=127.0.0.1
DB_PORT=13307
DB_NAME=homepage_dev
DB_USER=homepage_dev_user
DB_PASSWORD=change-me
# Local MySQL/Docker: disabled. AWS RDS: verify_identity with the downloaded CA bundle.
DB_SSL_MODE=disabled
DB_SSL_CA=

PII_ENCRYPTION_KEY=change-me-development-key
PII_ENCRYPTION_LEGACY_KEYS=
ACADEMY_PLAYBACK_TOKEN_SECRET=change-me-development-secret
ACADEMY_PLAYBACK_TOKEN_TTL_SEC=21600

# Development must not call real external providers.
ALLOW_EXTERNAL_EMAIL_SEND=false
ALLOW_EXTERNAL_SMS_SEND=false
ALLOW_EXTERNAL_KAKAO_SEND=false
ALLOW_EXTERNAL_PUSH_SEND=false
ALLOW_EXTERNAL_PAYMENT_CALLS=false
ACADEMY_PUBLISH_SCHEDULER_ENABLED=false
NOTIFICATION_SCHEDULER_ENABLED=false
DEBUG_VERIFICATION_CODES=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ICL Development <noreply@localhost>
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
KAKAO_SENDER_KEY=
KAKAO_DEFAULT_TEMPLATE=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_SECRETS=
