# Local-only port forwarding settings for the shared AWS development environment.
# Copy this file to `.env.development.tunnel` on each Windows/macOS computer.
# Do not commit the copied file or any AWS credential.
#
# Requires the AWS CLI, the Session Manager plugin, and AWS credentials that are
# allowed to call ssm:StartSession on the development instance. No SSH key and no
# inbound port 22 rule are involved, so a changing home IP does not matter.
ICL_DEV_ENVIRONMENT=development
ICL_DEV_DATABASE_NAME=homepage_dev

ICL_DEV_AWS_REGION=us-east-2
ICL_DEV_INSTANCE_ID=i-0000000000000example

# Frontend-only work: local Vite -> local 4001 -> development EC2 backend 4001.
ICL_DEV_API_LOCAL_PORT=4001
ICL_DEV_API_REMOTE_PORT=4001

# Backend work: local backend -> local 13307 -> development RDS 3306.
# 13306 은 다른 프로그램이 쓰는 경우가 많아 13307 을 사용한다.
ICL_DEV_DB_LOCAL_PORT=13307
ICL_DEV_DB_REMOTE_HOST=development-db.example.rds.amazonaws.com
ICL_DEV_DB_REMOTE_PORT=3306
