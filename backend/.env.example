NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=icl_pilates

# 알리고 SMS 및 카카오 알림톡 공통 계정
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 카카오 채널을 알리고에 연동한 뒤 발급받는 발신 프로필 키
KAKAO_SENDER_KEY=
# 관리자 화면에서 템플릿별 코드를 입력하지 않았을 때 사용할 기본 승인 템플릿 코드
KAKAO_DEFAULT_TEMPLATE=

# 알림 생성·예약 발송·실패 재시도 작업
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_SEC=30
NOTIFICATION_MAX_ATTEMPTS=10

# Firebase 서비스 계정 JSON의 project_id, client_email, private_key
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
