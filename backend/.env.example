NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=icl_pilates

# 운영 환경 필수 보안/결제 값
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_SECRETS=
ACADEMY_PLAYBACK_TOKEN_SECRET=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_LEGACY_KEYS=

# 이메일 발송
# 운영 SMTP 설정을 확인한 뒤에만 true로 변경합니다.
ALLOW_EXTERNAL_EMAIL_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=이끌림 필라테스 <noreply@icl-pilates.com>

# 알리고 SMS 및 카카오 알림톡 계정
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
KAKAO_SENDER_KEY=
KAKAO_DEFAULT_TEMPLATE=

# 알림 생성, 예약 발송, 실패 재시도 작업
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_SEC=30
NOTIFICATION_MAX_ATTEMPTS=10

# Firebase 서비스 계정 JSON의 project_id, client_email, private_key
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 교육영상 공개 예약 스케줄러
ACADEMY_PUBLISH_SCHEDULER_ENABLED=true
ACADEMY_PUBLISH_SCHEDULER_INTERVAL_SEC=60

# 외부 소셜 피드
SOCIAL_YOUTUBE_VIDEOS_URL=https://www.youtube.com/@ICL-PILATES/videos
SOCIAL_YOUTUBE_CHANNEL_ID=UC5WwEtRClHmSVB0tmUypryA
SOCIAL_BLOG_URL=https://blog.naver.com/icl_pilates
SOCIAL_BLOG_RSS_URL=https://rss.blog.naver.com/icl_pilates.xml
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/icl.pilates/
SOCIAL_FEED_CACHE_SECONDS=300
SOCIAL_FETCH_TIMEOUT_MS=8000
