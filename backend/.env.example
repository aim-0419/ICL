# Production backend example. Copy to .env only on the production host.
NODE_ENV=production
APP_ENV=production
PORT=4000
CORS_ORIGIN=https://icl-pilates.com,https://www.icl-pilates.com
MOBILE_APP_ORIGINS=https://localhost,capacitor://localhost
SITE_URL=https://icl-pilates.com
UPLOAD_ROOT=uploads

# Production startup must never mutate schema or seed data automatically.
DB_INIT_MODE=safe
ALLOW_DESTRUCTIVE_MIGRATIONS=false
ALLOW_STARTUP_DATA_PURGE=false
ALLOW_STARTUP_SCHEMA_DROP=false
ALLOW_STARTUP_USER_PURGE=false
ALLOW_STARTUP_SCHEMA_BOOTSTRAP=false
ALLOW_STARTUP_SCHEMA_ALTER=false
ALLOW_STARTUP_DATA_REPAIR=false
ALLOW_E2E_DATA_MUTATION=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=icl_pilates
DB_USER=icl_app_user
DB_PASSWORD=
DB_SSL_MODE=disabled
DB_SSL_CA=

PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_SECRETS=
ACADEMY_PLAYBACK_TOKEN_SECRET=
PII_ENCRYPTION_KEY=
PII_ENCRYPTION_LEGACY_KEYS=

ALLOW_EXTERNAL_EMAIL_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ICL Pilates <noreply@icl-pilates.com>

ALLOW_EXTERNAL_SMS_SEND=false
ALLOW_EXTERNAL_KAKAO_SEND=false
ALLOW_EXTERNAL_PUSH_SEND=false
ALLOW_EXTERNAL_PAYMENT_CALLS=false
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
KAKAO_SENDER_KEY=
KAKAO_DEFAULT_TEMPLATE=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_SCHEDULER_INTERVAL_SEC=30
NOTIFICATION_MAX_ATTEMPTS=10
ACADEMY_PUBLISH_SCHEDULER_ENABLED=false
ACADEMY_PUBLISH_SCHEDULER_INTERVAL_SEC=60

SOCIAL_YOUTUBE_VIDEOS_URL=https://www.youtube.com/@ICL-PILATES/videos
SOCIAL_YOUTUBE_CHANNEL_ID=
SOCIAL_BLOG_URL=https://blog.naver.com/icl_pilates
SOCIAL_BLOG_RSS_URL=https://rss.blog.naver.com/icl_pilates.xml
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/icl.pilates/
SOCIAL_FEED_CACHE_SECONDS=300
SOCIAL_FETCH_TIMEOUT_MS=8000
