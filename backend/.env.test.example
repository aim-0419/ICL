# Test environment example. Do not put real production secrets here.

NODE_ENV=test
TEST_SAFE_MODE=true
PORT=4000
CORS_ORIGIN=http://localhost:5173
MOBILE_APP_ORIGINS=https://localhost,capacitor://localhost
SITE_URL=http://localhost:5173
UPLOAD_ROOT=uploads-test

DB_INIT_MODE=safe
ALLOW_DESTRUCTIVE_MIGRATIONS=false
ALLOW_STARTUP_DATA_PURGE=false
ALLOW_STARTUP_SCHEMA_DROP=false
ALLOW_STARTUP_USER_PURGE=false
ALLOW_STARTUP_SCHEMA_BOOTSTRAP=false
ALLOW_STARTUP_SCHEMA_ALTER=false
ALLOW_STARTUP_DATA_REPAIR=false

# Non-destructive test default.
ALLOW_E2E_DATA_MUTATION=false

# Full E2E tests may enable this only with a dedicated test database.
# External email/SMS/Kakao/FCM/payment calls must remain disabled.
# Effective only when NODE_ENV is not production and DB_NAME clearly looks like a test/e2e/qa database.
# ALLOW_E2E_DATA_MUTATION=true

ACADEMY_PUBLISH_SCHEDULER_ENABLED=false
NOTIFICATION_SCHEDULER_ENABLED=false

ALLOW_EXTERNAL_EMAIL_SEND=false
ALLOW_EXTERNAL_SMS_SEND=false
ALLOW_EXTERNAL_KAKAO_SEND=false
ALLOW_EXTERNAL_PUSH_SEND=false
ALLOW_EXTERNAL_PAYMENT_CALLS=false

# Use a dedicated test DB only.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=homepage_test
DB_USER=test_user
DB_PASSWORD=change-me

# Do not use production secrets.
PII_ENCRYPTION_KEY=change-me-32-bytes-test-key
PII_ENCRYPTION_LEGACY_KEYS=
ACADEMY_PLAYBACK_TOKEN_SECRET=change-me-test-secret
ACADEMY_PLAYBACK_TOKEN_TTL_SEC=21600
JWT_SECRET=change-me-test-secret

# Optional demo admin. Keep disabled unless a local-only test needs it.
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_LOGIN_ID=demo-admin
DEMO_ADMIN_PASSWORD=change-me
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_ADMIN_NAME=Demo Admin

# External providers must remain disabled or mocked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_WEBHOOK_SECRETS=

ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
KAKAO_SENDER_KEY=
KAKAO_DEFAULT_TEMPLATE=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Social feed URLs are public references only.
SOCIAL_YOUTUBE_VIDEOS_URL=
SOCIAL_YOUTUBE_CHANNEL_ID=
SOCIAL_BLOG_URL=
SOCIAL_BLOG_RSS_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FEED_CACHE_SECONDS=300
SOCIAL_FETCH_TIMEOUT_MS=8000
