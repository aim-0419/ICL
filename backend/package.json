{
  "name": "icl-pilates-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-backend.mjs development --watch",
    "start": "node scripts/run-backend.mjs production",
    "start:test": "node scripts/run-backend.mjs test",
    "env:check:dev": "node scripts/check-runtime-environment.mjs development",
    "env:check:test": "node scripts/check-runtime-environment.mjs test",
    "env:check:prod": "node scripts/check-runtime-environment.mjs production",
    "tunnel:dev:api": "node scripts/open-development-tunnel.mjs api",
    "tunnel:dev:db": "node scripts/open-development-tunnel.mjs db",
    "db:provision:dev:local": "node scripts/provision-local-dev-db.mjs",
    "db:bootstrap:dev": "node scripts/bootstrap-development-db.mjs",
    "db:check:dev:isolation": "node scripts/check-development-db-isolation.mjs",
    "db:apply-schema:dev": "node scripts/apply-development-schema.mjs",
    "db:snapshot:dev": "node scripts/snapshot-development-db.mjs",
    "db:restore:dev": "node scripts/restore-development-db.mjs",
    "db:seed:dev:accounts": "node scripts/seed-development-accounts.mjs",
    "db:export:dev:sanitized": "node scripts/export-sanitized-development-data.mjs",
    "db:import:dev:sanitized": "node scripts/import-sanitized-development-data.mjs",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "mysql2": "^3.14.1",
    "nodemailer": "^9.0.3"
  }
}
