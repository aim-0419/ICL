server {
  listen 80;
  server_name dev.example.com;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name dev.example.com;

  # Replace the example host and issue a dedicated development certificate
  # before enabling this file.
  ssl_certificate /etc/letsencrypt/live/dev.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dev.example.com/privkey.pem;

  root /home/ubuntu/ICL-dev/frontend/dist;
  index index.html;
  client_max_body_size 5120m;

  location /assets/ {
    expires 1h;
    add_header Cache-Control "public";
  }

  location /api/ {
    proxy_pass http://127.0.0.1:4001/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;
  }

  location /uploads/academy/videos/ {
    return 403;
  }

  location /uploads/ {
    alias /home/ubuntu/ICL-dev/backend/uploads-dev/;
    expires 1h;
  }

  location / {
    add_header Cache-Control "no-store";
    try_files $uri $uri/ /index.html;
  }
}
