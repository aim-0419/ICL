# Frontend test environment example.

# Local tests normally use the Vite proxy.
VITE_API_BASE_URL=/api

# If a test runner calls the backend directly, use a non-secret local URL instead.
# VITE_API_BASE_URL=http://localhost:4000/api

VITE_APP_ENV=test
VITE_TEST_SAFE_MODE=true
VITE_E2E_BASE_URL=http://127.0.0.1:5173

# Do not put private keys here.
# Frontend variables are bundled and may be visible to users.
