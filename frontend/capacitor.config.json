{
  "appId": "com.iclpilates.app",
  "appName": "이끌림필라테스",
  "webDir": "dist",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "FirebaseMessaging": {
      "presentationOptions": ["alert", "badge", "sound"]
    }
  }
}
