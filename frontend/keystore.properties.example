# Android 릴리스 서명 설정 템플릿.
# 이 파일을 frontend/keystore.properties 로 복사한 뒤 실제 값을 채운다.
# keystore.properties 와 .jks 파일은 절대 커밋하지 않는다(.gitignore 등록됨).
#
# keystore 생성 (사용자가 직접 실행. 비밀번호를 대화형으로 입력한다):
#   keytool -genkeypair -v \
#     -keystore icl-release.jks \
#     -alias icl-release \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# 생성한 .jks 는 저장소 밖 안전한 위치에 두고, 비밀번호와 함께 오프라인 백업한다.
# 이 키를 잃어버리면 같은 패키지명으로 앱을 갱신할 수 없다.

storeFile=C:/secure/icl-release.jks
storePassword=
keyAlias=icl-release
keyPassword=
