{
  "name": "icl-pilates-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:app": "node scripts/run-app-vite.mjs dev development",
    "build": "vite build",
    "build:app": "node scripts/run-app-vite.mjs build production",
    "build:app:dev": "node scripts/run-app-vite.mjs build development",
    "build:app:prod": "node scripts/run-app-vite.mjs build production",
    "test:app-env": "node --test scripts/app-env.test.mjs",
    "test:env-isolation": "node --test scripts/app-env.test.mjs scripts/dev-proxy-env.test.mjs",
    "test:unit": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "validate:app:dev": "node scripts/validate-app-env.mjs development",
    "validate:app:prod": "node scripts/validate-app-env.mjs production",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.js",
    "test:e2e:app": "playwright test e2e/native-app.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync": "node scripts/run-capacitor-sync.mjs development",
    "cap:sync:dev": "node scripts/run-capacitor-sync.mjs development",
    "cap:sync:prod": "node scripts/run-capacitor-sync.mjs production",
    "cap:check": "node scripts/check-native-release.mjs",
    "android:reverse:dev": "node scripts/android-reverse.mjs",
    "cap:android": "npm run cap:sync:dev && npx cap open android",
    "cap:android:prod": "npm run cap:sync:prod && npx cap open android",
    "cap:ios": "npm run cap:sync:dev && npx cap open ios",
    "cap:ios:prod": "npm run cap:sync:prod && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@portone/browser-sdk": "^0.1.3",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "firebase": "^12.16.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
